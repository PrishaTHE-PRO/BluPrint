MONGODB_URI=             # MongoDB Atlas connection string
PORT=3001

CLOUDINARY_CLOUD_NAME=   # from cloudinary.com > Dashboard
CLOUDINARY_API_KEY=      # from cloudinary.com > Dashboard
CLOUDINARY_API_SECRET=   # from cloudinary.com > Dashboard

OPENAI_API_KEY=          # from platform.openai.com > API keys
SERPER_API_KEY=          # from serper.dev (shopping search)

# Same project id as VITE_FIREBASE_PROJECT_ID in the root .env. The server
# verifies sign-in tokens against it and refuses every /api/rooms call until
# it is set.
FIREBASE_PROJECT_ID=

# Optional. Comma-separated origins allowed to call the API from a browser.
# Same-origin needs nothing, so leave empty unless the front-end is hosted
# elsewhere.
CORS_ORIGINS=

# Room photo render (results page). Image edits cost far more per call than
# chat completions; medium quality at 1536x1024 is the default for that reason.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Leave OPENAI_IMAGE_SIZE unset and the output matches the photo's orientation
# (1536x1024, 1024x1536 or 1024x1024). Set it only to force one size.
# OPENAI_IMAGE_SIZE=1536x1024
# How closely the render keeps the original room. "high" is the default; set
# "off" only if the model in use rejects the parameter every time.
OPENAI_IMAGE_INPUT_FIDELITY=high
